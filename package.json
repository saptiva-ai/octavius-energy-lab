{
  "name": "octavios-chat-monorepo",
  "private": true,
  "packageManager": "bun@1.3.4",
  "pnpm": {
    "overrides": {
      "glob": "10.5.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bun:install": "bun install",
    "bun:dev:web": "cd apps/web && bun run dev:bun",
    "bun:build:web": "cd apps/web && bun run build:bun",
    "bun:start:web": "cd apps/web && bun run start:bun",
    "bun:typecheck:web": "cd apps/web && bun run typecheck",
    "bun:lint:web": "cd apps/web && bun run lint",
    "bun:test:web": "cd apps/web && bun run test:bun"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "nanoid": "^3.3.18",
    "next": "^15.5.21",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
